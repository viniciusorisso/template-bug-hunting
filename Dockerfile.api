FROM node:22-bookworm-slim AS builder
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api ./apps/api
COPY packages/core ./packages/core

RUN pnpm install --frozen-lockfile
RUN pnpm build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001

COPY --from=builder /app/apps/api/dist ./apps/api/dist
RUN mkdir -p ./node_modules/@ts-bug-hunt/core
COPY --from=builder /app/apps/api/dist/packages/core/src/ ./node_modules/@ts-bug-hunt/core/
RUN printf '{"name":"@ts-bug-hunt/core","type":"module","main":"./index.js"}\n' > ./node_modules/@ts-bug-hunt/core/package.json

EXPOSE 3001
CMD ["node", "apps/api/dist/apps/api/src/server.js"]
